datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SeatLocation {
  WINDOW
  MIDDLE
  AISLE
}

enum FlightStatus {
  SCHEDULED
  DELAYED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TicketStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FLIGHT_CANCELLED
}

enum TransactionStatus {
  SUCCESS
  FAILED
  PENDING
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            Int            @id @default(autoincrement())
  firstName     String
  lastName      String
  email         String         @unique
  phoneNumber   String
  password      String
  role          UserRole       @default(USER)
  passengers    Passenger[]
  bookings      Booking[]
  createdAt     DateTime       @default(now())
  notifications Notification[]
}

model Airport {
  airportCode String   @id
  city        String
  country     String
  name        String
  departures  Flight[] @relation("SourceAirport")
  arrivals    Flight[] @relation("DestinationAirport")
}

model Airline {
  airlineCode String   @id
  name        String
  flights     Flight[]
}

model Aircraft {
  aircraftId   Int      @id @default(autoincrement())
  model        String
  manufacturer String
  flights      Flight[]
  seats        Seat[]
}

model Seat {
  seatId     Int          @id @default(autoincrement())
  seatNumber String
  location   SeatLocation
  aircraftId Int
  aircraft   Aircraft     @relation(fields: [aircraftId], references: [aircraftId])
  tickets    Ticket[]

  @@unique([aircraftId, seatNumber])
}

model Flight {
  flightId           Int          @id @default(autoincrement())
  flightNum          String
  airlineCode        String
  airline            Airline      @relation(fields: [airlineCode], references: [airlineCode])
  sourceCode         String
  sourceAirport      Airport      @relation("SourceAirport", fields: [sourceCode], references: [airportCode])
  destCode           String
  destAirport        Airport      @relation("DestinationAirport", fields: [destCode], references: [airportCode])
  aircraftId         Int
  aircraft           Aircraft     @relation(fields: [aircraftId], references: [aircraftId])
  departureTime      DateTime
  arrivalTime        DateTime
  durationMinutes    Int
  price              Float
  status             FlightStatus @default(SCHEDULED)
  cancellationReason String?
  bookings           Booking[]
}

model Passenger {
  passengerId    Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  firstName      String
  lastName       String
  gender         String?
  nationality    String?
  passportNumber String?
  email          String?
  phoneNumber    String?
  tickets        Ticket[]
}

model Booking {
  bookingId   Int           @id @default(autoincrement())
  pnr         String        @unique
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
  flightId    Int
  flight      Flight        @relation(fields: [flightId], references: [flightId])
  bookingDate DateTime      @default(now())
  totalAmount Float
  status      BookingStatus @default(PENDING)
  tickets     Ticket[]
  payment     Payment?
  refunds     Refund[]
}

model Ticket {
  ticketId           Int          @id @default(autoincrement())
  bookingId          Int
  booking            Booking      @relation(fields: [bookingId], references: [bookingId], onDelete: Cascade)
  passengerId        Int
  passenger          Passenger    @relation(fields: [passengerId], references: [passengerId])
  seatId             Int
  seat               Seat         @relation(fields: [seatId], references: [seatId])
  status             TicketStatus @default(PENDING)
  cancellationReason String?
  refunds            Refund[]
}

model Payment {
  paymentId            Int               @id @default(autoincrement())
  bookingId            Int               @unique
  booking              Booking           @relation(fields: [bookingId], references: [bookingId])
  pnr                  String
  amountPaid           Float
  transactionStatus    TransactionStatus
  gatewayTransactionId String
  transactionDate      DateTime          @default(now())
  message              String
  refunds              Refund[]
}

model Refund {
  refundId  Int          @id @default(autoincrement())
  bookingId Int
  booking   Booking      @relation(fields: [bookingId], references: [bookingId], onDelete: Cascade)
  ticketId  Int          @unique
  ticket    Ticket       @relation(fields: [ticketId], references: [ticketId], onDelete: Cascade)
  paymentId Int?
  payment   Payment?     @relation(fields: [paymentId], references: [paymentId], onDelete: SetNull)
  amount    Float
  status    RefundStatus @default(PENDING)
  reason    String
  createdAt DateTime     @default(now())
}

model Notification {
  notificationId Int                @id @default(autoincrement())
  userId         Int
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  message        String
  status         NotificationStatus @default(PENDING)
  createdAt      DateTime           @default(now())

  @@index([userId, status])
}
