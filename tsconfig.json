{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@spartan-ng/helm/button": ["./src/shared/button/src/index.ts"],
      "@spartan-ng/helm/utils": ["./src/shared/utils/src/index.ts"],
      "@spartan-ng/helm/avatar": ["./src/shared/avatar/src/index.ts"],
      "@spartan-ng/helm/dropdown-menu": [
        "./src/shared/dropdown-menu/src/index.ts"
      ],
      "@spartan-ng/helm/input-group": ["./src/shared/input-group/src/index.ts"],
      "@spartan-ng/helm/input": ["./src/shared/input/src/index.ts"],
      "@spartan-ng/helm/textarea": ["./src/shared/textarea/src/index.ts"],
      "@spartan-ng/helm/field": ["./src/shared/field/src/index.ts"],
      "@spartan-ng/helm/label": ["./src/shared/label/src/index.ts"],
      "@spartan-ng/helm/separator": ["./src/shared/separator/src/index.ts"],
      "@spartan-ng/helm/spinner": ["./src/shared/spinner/src/index.ts"],
      "@spartan-ng/helm/select": ["./src/shared/select/src/index.ts"],
      "@spartan-ng/helm/dialog": ["./src/shared/dialog/src/index.ts"],
      "@spartan-ng/helm/sonner": ["./src/shared/sonner/src/index.ts"],
      "@spartan-ng/helm/input-otp": ["./src/shared/input-otp/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
